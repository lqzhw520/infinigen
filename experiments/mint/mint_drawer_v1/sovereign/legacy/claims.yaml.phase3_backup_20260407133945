- claim_id: C_STATE_CONTRACT
  current_revision: 14
  lifecycle_status: active
  superseded_by: null
  supersedes: null
  split_from: null
  split_into: []
  revisions:
  - revision: 1
    statement: "Infinigen observation.state[8] format is [eef_pos(3) + eef_quat(4)\
      \ + gripper_binary(1)] with gripper \u2208 {0,1}. LIBERO observation.state[8]\
      \ format is [x,y,z, rx,ry,rz,rw, gripper_joint] where state[7] is a continuous\
      \ joint position (min=-0.041, max=0.001, std=0.013), NOT binary. MINT processor_mint.py\
      \ digitizes state[7] into 256 bins \u2192 text token. When Infinigen state[7]={0,1}\
      \ gets quantized, it lands in completely wrong bins compared to LIBERO's continuous\
      \ joint positions, causing MINT's state tokenizer to emit incoherent tokens.\
      \ This is P1a and is higher priority than camera/render alignment."
    scope: v58_state_contract_alignment
    status: candidate
    evidence_ids:
    - E004
    - E005
    change_type: create
    change_reason: "Established from stats.json audit: LIBERO state[7] std=0.013 (continuous),\
      \ not binary. Infinigen drawer_robot_env._state_vector() puts binary gripper\
      \ in state[7]. MINT processor_mint.py digitizes state \u2192 text. Codex review\
      \ confirms: observation.contract is higher priority than vision encoder for\
      \ ever_attached=0."
    created_at: '2026-04-02T03:00:00+08:00'
